# v0.14 : SFC asynchrone — la fenêtre principale reste réactive pendant l'analyse.
# On s'abonne à l'événement Exited du processus via Register-ObjectEvent.
$BtnSfc.Add_Click({ 
    # Réinitialiser l'état du bouton de log à chaque lancement
    $BtnViewSfcLog.Visible = $false

    if (Confirm-Action $Translations[$Script:CurrentLang].MsgSfc) { 
        $L = $Translations[$Script:CurrentLang]
        $SfcReportPath = Join-Path $env:TEMP "SFC_Details.txt"

        # Construction de la commande SFC + extraction du rapport dans %TEMP%
        $SfcCmd = "$ConsoleSetup sfc.exe /scannow; " +
                  "`$LogPath = '$SfcReportPath'; " +
                  "if (Test-Path `"`$env:windir`\Logs`\CBS`\CBS.log`") { " +
                  "  Write-Host 'Extraction du rapport SFC (peut prendre un moment)...' -ForegroundColor Cyan; " +
                  "  try { Select-String -Path `"`$env:windir`\Logs`\CBS`\CBS.log`" -Pattern '\[SR\]' -ErrorAction Stop | ForEach-Object { `$_.Line } | Set-Content -LiteralPath `$LogPath -Encoding UTF8; " +
                  "    Write-Host 'Rapport SFC sauvegarde.' -ForegroundColor Green } " +
                  "  catch { Write-Host 'Echec extraction rapport SFC.' -ForegroundColor Red } " +
                  "} else { Write-Host 'CBS.log introuvable.' -ForegroundColor Yellow }; " +
                  "Write-Host `"`r`nRapport disponible : `$LogPath`" -ForegroundColor Cyan"
        
        Write-Log $L.SfcRunning

        # Lancement sans WaitForExit : la fenêtre principale reste utilisable
        $SfcProc = Start-Process powershell -ArgumentList "-NoProfile -NoExit -Command `"$SfcCmd`"" -PassThru

        # Détection asynchrone de la fin du processus
        $SfcEventAction = {
            $SfcReportPath = Join-Path $env:TEMP "SFC_Details.txt"
            if ((Test-Path -LiteralPath $SfcReportPath) -and ((Get-Item -LiteralPath $SfcReportPath).Length -gt 0)) {
                $BtnViewSfcLog.Visible = $true
                $msg = $Translations[$Script:CurrentLang].SfcExtracted -replace '%LOGPATH%', $SfcReportPath
            } else {
                $msg = $Translations[$Script:CurrentLang].SfcEmpty
            }
            Write-Log $msg
        }
        # Register-ObjectEvent déclenche $SfcEventAction quand $SfcProc se termine
        Register-ObjectEvent -InputObject $SfcProc -EventName Exited -Action $SfcEventAction | Out-Null
    } 
})

$BtnViewSfcLog.Add_Click({ 
    $SfcReportPath = Join-Path $env:TEMP "SFC_Details.txt"
